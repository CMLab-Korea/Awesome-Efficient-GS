graph TB
    Root["4. DYNAMIC SCENES"]

    %% Main Categories
    Root --> C1["4.1 Parameter Compression"]
    Root --> C2["4.2 Restructuring Compression"]

    %% Parameter Compression subcategories
    C1 --> S1["4.1.1 Gaussian Pruning<br/>8 papers"]
    C1 --> S2["4.1.2 Attribute Pruning<br/>1 paper"]
    C1 --> S3["4.1.3 Quantization<br/>2 papers"]
    C1 --> S4["4.1.4 Entropy-based<br/>6 papers"]

    %% Restructuring Compression subcategories
    C2 --> S5["4.2.1 Anchor-based Representation<br/>11 papers"]
    C2 --> S6["4.2.2 Canonical Deformable Representation<br/>10 papers"]
    C2 --> S7["4.2.3 LoD Representation<br/>4 papers"]
    C2 --> S8["4.2.4 Mixture-of-Experts<br/>1 paper"]

    %% 4.1.1 Gaussian Pruning
    S1 --- P1["Temporally Compressed<br/>BMVC 2025"]
